<Application x:Class="StroyMateriali.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StroyMateriali"
             StartupUri="Windows/Auth.xaml">
    <Application.Resources>
        <SolidColorBrush Color="#FFFFFF" x:Key="Osnova"/>
        <SolidColorBrush Color="#DAA520" x:Key="Dop"/>
        <SolidColorBrush Color="#B8860B" x:Key="Akcent"/>
        <SolidColorBrush Color="#F4A460" x:Key="Skidka"/>
        
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style TargetType="Window" x:Key="Windows">
            <Setter Property="Height" Value="800"/>
            <Setter Property="MaxHeight" Value="830"/>
            <Setter Property="MinHeight" Value="770"/>

            <Setter Property="Width" Value="800"/>
            <Setter Property="MaxWidth" Value="830"/>
            <Setter Property="MinWidth" Value="770"/>

            <Setter Property="Background" Value="{StaticResource Osnova}"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Icon" Value="/Resources/Image/icon.ico"/>
        </Style>
        
        <Style TargetType="TextBox" x:Key="TextBoxs">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TextBlocks">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="Buttons">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource Dop}"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Application.Resources>
</Application>
