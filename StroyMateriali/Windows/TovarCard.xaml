<UserControl x:Class="StroyMateriali.Windows.TovarCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StroyMateriali.Windows"
        mc:Ignorable="d"
        Height="300" Width="750" >
    <DockPanel>
        <Border>
            <Viewbox Height="200" Width="200">
                <Image x:Name="Photo" Source="/Resources/Image/picture.png" Stretch="Uniform"/>
            </Viewbox>
        </Border>
        <Border>
            <StackPanel Orientation="Vertical" Width="320">
                <TextBlock x:Name="ArticulImaBlock" TextWrapping="Wrap"/>
                <TextBlock x:Name="OpisanieBlock" TextWrapping="Wrap"/>
                <TextBlock x:Name="ProizvoditelBlock"/>
                <TextBlock x:Name="PostavshikBlock"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CenaBlock"/>
                    <TextBlock x:Name="ItogCenaBlock"/>
                </StackPanel>
                <TextBlock x:Name="EdinicaBlock"/>
                <TextBlock x:Name="KolichestvoBlock"/>
            </StackPanel>
        </Border>
        <Border Width="150">
            <TextBlock x:Name="SkidkaBlock" HorizontalAlignment="Center" Style="{StaticResource TextBlocks}"/>
        </Border>
    </DockPanel>
</UserControl>
