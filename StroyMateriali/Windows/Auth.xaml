<Window x:Class="StroyMateriali.Windows.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StroyMateriali.Windows"
        mc:Ignorable="d"
        Title="Авторизация" Style="{StaticResource Windows}">
    <DockPanel>
        <StackPanel Height="75" DockPanel.Dock="Top" Orientation="Horizontal">
            <Image Source="/Resources/Image/icon.png" Width="75" HorizontalAlignment="Left"/>
            <TextBlock Style="{StaticResource TextBlocks}" VerticalAlignment="Center">Строй материалы</TextBlock>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Width="400">
            <TextBlock Style="{StaticResource TextBlocks}">Логин</TextBlock>
            <TextBox Style="{StaticResource TextBoxs}" x:Name="LoginBox"></TextBox>
            <TextBlock Style="{StaticResource TextBlocks}">Пароль</TextBlock>
            <TextBox Style="{StaticResource TextBoxs}" x:Name="ParolBox"></TextBox>

            <Button Style="{StaticResource Buttons}" Click="Auth_Click" >Войти</Button>
            <Button Style="{StaticResource Buttons}" Click="AuthGhost_Click">Войти как гость</Button>
        </StackPanel>
    </DockPanel>
</Window>
