<Window x:Class="StroyMateriali.Windows.ZakazRedactir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Style="{StaticResource Windows}">

    <StackPanel Margin="10">
        <TextBlock>Артикул заказа</TextBlock>
        <TextBox x:Name="NomerBox" IsReadOnly="True"/>

        <TextBlock>Статус заказа</TextBlock>
        <ComboBox x:Name="StatusBox" DisplayMemberPath="Ima"/>

        <TextBlock>Адрес пункта выдачи</TextBlock>
        <ComboBox x:Name="PynktBox" DisplayMemberPath="Adres"/>

        <TextBlock>Дата заказа</TextBlock>
        <DatePicker x:Name="DataZakazaBox"/>

        <TextBlock>Дата доставки</TextBlock>
        <DatePicker x:Name="DataDostavkaBox"/>

        <Button x:Name="Save" Click="Save_Click">Сохранить</Button>
        <Button x:Name="Udalit" Click="Udalit_Click"
                Visibility="Collapsed">Удалить заказ</Button>
        <Button Click="Nazad_Click">Назад</Button>
    </StackPanel>
</Window>